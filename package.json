{
  "name": "enterprise-service-agent",
  "version": "0.1.0",
  "private": true,
  "description": "小助个人工作助手 Demo：工作陪伴、知识库问答、客户评审准备与 IT / 行政人工接入",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed:reset": "node scripts/reset-runtime.mjs",
    "eval:retrieval": "node scripts/eval-retrieval.mjs",
    "eval:threshold": "node scripts/tune-threshold.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:llm": "node scripts/smoke-llm.mjs",
    "llm:fake": "node scripts/fake-llm-server.mjs 8123",
    "llm:models": "node scripts/list-models.mjs",
    "dev:llm-fake": "AGENT_ENGINE=llm LLM_BASE_URL=http://localhost:8123 LLM_API_KEY=fake-key LLM_MODEL=fake-glm next dev",
    "dev:llm": "AGENT_ENGINE=llm next dev"
  },
  "dependencies": {
    "next": "15.5.24",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.24",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  }
}
