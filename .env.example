# 复制成 .env.local 后按需修改。.env.local 已在 .gitignore 里，不会被提交。
#
# 默认（不配任何变量）= 规则引擎 mock 模式，零依赖零成本，clone 下来直接 npm run dev 就能跑。

# ── 推理引擎 ──────────────────────────────────────────────────────────────
# mock = 规则引擎（关键词正则识别意图 + 模板拼装回复）
# llm  = 大模型驱动（意图识别用 function calling，回复生成用 System Prompt）
#
# 注意：设成 llm 但没填 LLM_API_KEY 会**直接启动失败**，不会静默退回规则引擎。
# 因为界面上的「引擎」标签取自这个配置，静默降级会导致演示时标称大模型而实际跑规则。
AGENT_ENGINE=mock

# ── 大模型接入（AGENT_ENGINE=llm 时必填）──────────────────────────────────
# 任何 OpenAI 兼容协议的供应商都可以，换供应商只改这三行。
#
# 智谱 BigModel（推荐：glm-4.7-flash / glm-4.5-flash 免费）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your-zhipu-api-key
LLM_MODEL=glm-4.7-flash
#
# 其他供应商示例（注释掉上面三行，换成下面任一组）：
#   DeepSeek     LLM_BASE_URL=https://api.deepseek.com      LLM_MODEL=deepseek-chat
#   通义千问     LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-flash
#   Moonshot     LLM_BASE_URL=https://api.moonshot.cn/v1     LLM_MODEL=kimi-k2.6
#   本地 Ollama  LLM_BASE_URL=http://localhost:11434/v1      LLM_MODEL=qwen3
#
# 不确定模型名？跑 npm run llm:models 列出你的 Key 实际可用的模型。

# ── 大模型可调参数（都有默认值，一般不用改）───────────────────────────────
# LLM_TEMPERATURE=0.2        # 内部服务场景要稳定，别调高
# LLM_MAX_TOKENS=1600
# LLM_TIMEOUT_MS=30000
# LLM_MAX_RETRIES=2          # 只对限流/5xx/超时/网络错误重试
# LLM_FALLBACK_TO_RULES=true # 单次调用失败时降级到规则引擎保证可用性。
#                            # 降级会在结果里标 degraded=true 并在链路中写明原因，
#                            # 界面也会显示降级提示，绝不伪装成大模型输出。
#                            # 设 false 则直接返回错误（想严格暴露问题时用）。

# ── 演示用的当前登录员工（不接 SSO 时用它模拟身份）────────────────────────
NEXT_PUBLIC_DEMO_EMPLOYEE_ID=E1001

# ── 向量检索（尚未实现，占位）─────────────────────────────────────────────
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
