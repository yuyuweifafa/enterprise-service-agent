    "replyPrefix": "这个不在小助当前的服务范围内。",
    "replySuffix": "我现在主要能帮你：陪你理清工作、回答公司制度、准备客户评审，以及把 IT/行政问题带上下文转给人工。",
    "rules": [
      {
        "id": "scope.market_news",
        "label": "新闻 / 股价 / 市场行情",
        "matchMode": "contains",
        "patterns": ["股价", "股票", "基金", "比特币", "今天新闻", "最新消息", "汇率是多少"],
        "reply": "这类市场或新闻信息不在当前服务范围里。"
      },
      {
        "id": "scope.coding",
        "label": "编程实现",
        "matchMode": "contains",
        "patterns": ["写代码", "写一个函数", "冒泡排序", "sql 怎么写", "正则怎么写", "帮我改代码"],
        "reply": "当前小助不处理编程实现问题。"
      },
      {
        "id": "scope.personal_life",
        "label": "生活娱乐",
        "matchMode": "contains",
        "patterns": ["推荐餐厅", "哪家好吃", "午饭吃什么", "晚饭吃什么", "推荐电影", "讲个笑话"],
        "reply": "生活娱乐类问题暂时不在当前服务范围里。"
      }
    ]
  },
  "smallTalk": {
    "enabled": true,
    "minMeaningfulChars": 2,
    "rules": [
      {
        "id": "chitchat.greeting",
        "label": "问候",
        "matchMode": "full",
        "patterns": ["你好", "您好", "哈喽", "hello", "hi", "hey", "在吗", "在么", "早上好", "下午好", "晚上好"],
        "reply": "你好，我是小助。你可以直接告诉我一个工作目标，或者问我公司制度、IT/行政问题。"
      },
      {
        "id": "chitchat.emotion",
        "label": "情绪陪伴",
        "matchMode": "contains",
        "patterns": ["不开心", "心情不好", "有点烦", "很烦", "难过", "有点累", "好累", "压力好大", "有点焦虑", "很焦虑", "有点紧张"],
        "reply": "听起来你现在状态不太好。先别急着把自己往前推，我们可以先把事情拆小一点：\n\n1. 先说说让你不开心的主要原因，是人、事、时间压力，还是不确定感？\n2. 如果你不想展开，也可以直接把今天要做的事丢给我，我帮你排一个更轻的顺序。\n3. 现在先做一件 10 分钟内能完成的小事，让状态慢慢回来。"
      },
      {
        "id": "chitchat.thanks",
        "label": "致谢",
        "matchMode": "full",
        "patterns": ["谢谢", "谢了", "多谢", "感谢", "thanks", "thank you", "收到谢谢"],
        "reply": "不客气。还有其他需要处理的事情，直接说就好。"
      },
      {
        "id": "chitchat.ack",
        "label": "无实义应答",
        "matchMode": "full",
        "patterns": ["好的", "好", "嗯", "嗯嗯", "哦", "ok", "okay", "行", "知道了", "明白", "收到", "可以"],
        "reply": "嗯，需要我帮你理什么事，直接说。"
      }
    ]
  },
