{
  "$comment": "当前 Demo 只保留 5 个模拟能力：知识库检索、员工档案、日程空闲、会议室查询/预定、消息/日程提醒；另保留请假余额和知识缺口沉淀用于演示。",
  "version": "0.2.0",
  "tools": [
    {
      "id": "hr.get_employee",
      "name": "查询员工档案",
      "description": "根据工号查询员工姓名、部门、职级、办公地、直属上级、年假和调休信息。",
      "endpoint": "/api/employees/:employeeId",
      "method": "GET",
      "sideEffect": "read",
      "requiresApproval": false,
      "args": [{ "name": "employeeId", "type": "string", "required": true, "from": "context", "path": "employee.id" }]
    },
    {
      "id": "leave.get_balance",
      "name": "查询假期余额",
      "description": "读取员工年假、调休等可用假期余额，用于请假流程入口前的信息整理。",
      "endpoint": "/api/mock/hr/leave-balance",
      "method": "GET",
      "sideEffect": "read",
      "requiresApproval": false,
      "args": [{ "name": "employeeId", "type": "string", "required": true, "from": "context", "path": "employee.id" }]
    },
    {
      "id": "kb.search",
      "name": "检索知识库",
      "description": "在 IT / HR / 财务 / 行政知识库中检索制度、流程和操作说明，返回带来源和相似度的片段。",
      "endpoint": "/api/knowledge/search",
      "method": "GET",
      "sideEffect": "read",
      "requiresApproval": false,
      "args": [
        { "name": "q", "type": "string", "required": true, "from": "context", "path": "intent.query" },
        { "name": "domain", "type": "string", "required": false, "from": "context", "path": "intent.domain" }
      ]
    },
    {
      "id": "calendar.find_slots",
      "name": "识别空闲时间",
      "description": "读取员工日程，找出目标日期可用于客户评审的空闲时间。",
      "endpoint": "/api/mock/calendar/slots",
      "method": "GET",
      "sideEffect": "read",
      "requiresApproval": false,
      "args": [
        { "name": "employeeId", "type": "string", "required": true, "from": "context", "path": "employee.id" },
        { "name": "date", "type": "string", "required": false, "from": "slot", "slot": "startDate" }
      ]
    },
    {
      "id": "meeting.find_rooms",
      "name": "查询会议室",
      "description": "根据员工所在地、日期、人数和空闲时间查询可用会议室。",
      "endpoint": "/api/mock/meeting/rooms",
      "method": "GET",
      "sideEffect": "read",
      "requiresApproval": false,
      "args": [
        { "name": "location", "type": "string", "required": false, "from": "context", "path": "employee.location" },
        { "name": "date", "type": "string", "required": false, "from": "slot", "slot": "startDate" },
        { "name": "headcount", "type": "number", "required": false, "from": "slot", "slot": "headcount" }
      ]
    },
    {
      "id": "docs.search_customer_history",
      "name": "搜索客户历史资料",
      "description": "检索客户历史会议纪要、聊天记录和方案文档，提取本次评审需要准备的资料清单。",
      "endpoint": "/api/mock/docs/customer-history",
      "method": "GET",
      "sideEffect": "read",
      "requiresApproval": false,
      "args": [{ "name": "query", "type": "string", "required": true, "from": "context", "path": "intent.query" }]
    },
    {
      "id": "weather.get_forecast",
      "name": "查询天气与通勤提醒",
      "description": "查询目标日期的天气、通勤和着装建议，用于客户评审前提醒。",
      "endpoint": "/api/mock/weather",
      "method": "GET",
      "sideEffect": "read",
      "requiresApproval": false,
      "args": [
        { "name": "location", "type": "string", "required": false, "from": "context", "path": "employee.location" },
        { "name": "date", "type": "string", "required": false, "from": "slot", "slot": "startDate" }
      ]
    },
    {
      "id": "meeting.book_room",
      "name": "锁定会议室",
      "description": "根据推荐空闲时间锁定候选会议室；客户时间最终确认前可调整。",
      "endpoint": "/api/mock/meeting/book",
      "method": "POST",
      "sideEffect": "write",
      "requiresApproval": false,
      "args": [
        { "name": "employeeId", "type": "string", "required": true, "from": "context", "path": "employee.id" },
        { "name": "date", "type": "string", "required": false, "from": "slot", "slot": "startDate" }
      ]
    },
    {
      "id": "reminder.create",
      "name": "推送日程提醒",
      "description": "把需要员工主动完成的动作写入个人日程，例如联系客户确认时间、会前检查材料。",
      "endpoint": "/api/mock/reminders",
      "method": "POST",
      "sideEffect": "write",
      "requiresApproval": false,
      "args": [
        { "name": "employeeId", "type": "string", "required": true, "from": "context", "path": "employee.id" },
        { "name": "title", "type": "string", "required": true, "from": "context", "path": "intent.title" },
        { "name": "date", "type": "string", "required": false, "from": "slot", "slot": "startDate" }
      ]
    },
    {
      "id": "kb.record_gap",
      "name": "记录知识缺口",
      "description": "知识库无命中时沉淀一条待补充知识条目，供知识运营补写。",
      "endpoint": "/api/knowledge/gaps",
      "method": "POST",
      "sideEffect": "write",
      "requiresApproval": false,
      "args": [
        { "name": "question", "type": "string", "required": true, "from": "context", "path": "intent.query" },
        { "name": "domain", "type": "string", "required": true, "from": "context", "path": "intent.domain" },
        { "name": "employeeId", "type": "string", "required": true, "from": "context", "path": "employee.id" },
        { "name": "intentId", "type": "string", "required": false, "from": "context", "path": "intent.id" }
      ]
    },
    {
      "id": "log.trace",
      "name": "记录 Agent 处理日志",
      "description": "写入完整处理链路：意图、检索命中、风险判定、工具调用、耗时、最终动作。",
      "endpoint": "/api/logs",
      "method": "POST",
      "sideEffect": "write",
      "requiresApproval": false,
      "args": [{ "name": "trace", "type": "object", "required": true, "from": "context", "path": "trace" }]
    }
  ]
}
